# LLM Provider Configuration (Default: groq)
# Options: groq, openai, gemini, ollama, auto
LLM_PROVIDER=groq

# Groq API Key (Get a free key from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (Optional)
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama Local Server URL (Default: http://localhost:11434/v1)
OLLAMA_HOST=http://localhost:11434/v1

# Whisper Speech Recognition Model (Default: base)
# Options: tiny, base, small, turbo
WHISPER_MODEL=base
